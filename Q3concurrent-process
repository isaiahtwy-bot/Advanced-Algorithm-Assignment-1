
import threading
import time


# Fibonacci Function
def fibonacci(n):
    if n <= 1:
        return n

    return fibonacci(n - 1) + fibonacci(n - 2)

# Thread Worker Function
def calculate_fibonacci(n, results, finish_times):
    # Calculate Fibonacci number
    result = fibonacci(n)

    # Store the result
    results[n] = result

    # Record the finishing time of this thread
    finish_times[n] = time.perf_counter_ns()

# Multithreading Experiment
def multithreading_test(rounds):
    numbers = [35, 38, 40]
    execution_times = []

    print("\n==============================================")
    print("       MULTITHREADING EXPERIMENT")
    print("==============================================")

    for round_num in range(1, rounds + 1):

        results = {}
        finish_times = {}
        threads = []

        # Create three separate threads
        for n in numbers:
            thread = threading.Thread(
                target=calculate_fibonacci,
                args=(n, results, finish_times)
            )

            threads.append(thread)

        # Record start time immediately before starting
        # the first thread
        start_time = time.perf_counter_ns()

        # Start all three threads
        for thread in threads:
            thread.start()

        # Wait for all threads to finish
        for thread in threads:
            thread.join()

        # Get the finishing time of the last thread
        end_time = max(finish_times.values())

        # Calculate total elapsed time
        elapsed_time = end_time - start_time

        execution_times.append(elapsed_time)

        print(f"\nRound {round_num}")
        print("----------------------------------------------")

        for n in numbers:
            print(f"Fibonacci({n}) = {results[n]}")

        print(f"Total Time: {elapsed_time:,} ns")

    # Calculate average execution time
    average_time = sum(execution_times) / rounds

    print("\n==============================================")
    print("MULTITHREADING RESULTS")
    print("==============================================")

    for i, elapsed_time in enumerate(execution_times, start=1):
        print(f"Round {i}: {elapsed_time:,} ns")

    print("----------------------------------------------")
    print(f"Average Time: {average_time:,.2f} ns")

# Sequential Experiment
def sequential_test(rounds):
    numbers = [35, 38, 40]
    execution_times = []

    print("\n==============================================")
    print("       SEQUENTIAL EXPERIMENT")
    print("==============================================")

    for round_num in range(1, rounds + 1):

        results = {}

        # Record start time before first calculation
        start_time = time.perf_counter_ns()

        # Calculate Fibonacci numbers one by one
        for n in numbers:
            results[n] = fibonacci(n)

        # Record end time after all calculations
        end_time = time.perf_counter_ns()

        # Calculate total elapsed time
        elapsed_time = end_time - start_time

        execution_times.append(elapsed_time)

        print(f"\nRound {round_num}")
        print("----------------------------------------------")

        for n in numbers:
            print(f"Fibonacci({n}) = {results[n]}")

        print(f"Total Time: {elapsed_time:,} ns")

    # Calculate average execution time
    average_time = sum(execution_times) / rounds

    print("\n==============================================")
    print("SEQUENTIAL RESULTS")
    print("==============================================")

    for i, elapsed_time in enumerate(execution_times, start=1):
        print(f"Round {i}: {elapsed_time:,} ns")

    print("----------------------------------------------")
    print(f"Average Time: {average_time:,.2f} ns")


# Main Program
def main():

    total_rounds = 10

    print("==============================================")
    print("       FIBONACCI PERFORMANCE TEST")
    print("==============================================")

    print("Fibonacci numbers: 35, 38, 40")
    print(f"Number of rounds: {total_rounds}")

    # Run multithreading experiment
    multithreading_test(total_rounds)

    # Run sequential experiment
    sequential_test(total_rounds)

    print("\n==============================================")
    print("       ALL TESTS COMPLETED")
    print("==============================================")


if __name__ == "__main__":
    main()
